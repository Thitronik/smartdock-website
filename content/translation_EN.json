14:29:38.179Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.179Z", "en": "Contact Information", "id": "m19vmh45zv1zloc", "key": "contact_info_title", "page": "home", "section": "contact_info", "updated": "2026-07-15 14:29:38.179Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.179Z", "en": "A direct line to our team in Eckernförde.", "id": "ufz2a26rnmxpgvl", "key": "contact_info_subtitle", "page": "home", "section": "contact_info", "updated": "2026-07-15 14:29:38.179Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.179Z", "en": "PHONE (general office)", "id": "996h1ydscp5hqp2", "key": "contact_info_phone_label", "page": "home", "section": "contact_info", "updated": "2026-07-15 14:29:38.179Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.180Z", "en": "+49 4351 76744-0", "id": "rcve4bkc2q0dafd", "key": "contact_info_phone_number", "page": "home", "section": "contact_info", "updated": "2026-07-15 14:29:38.180Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.180Z", "en": "E-MAIL", "id": "lwsc1w9taqhnxkn", "key": "contact_info_email_label", "page": "home", "section": "contact_info", "updated": "2026-07-15 14:29:38.180Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.180Z", "en": "smartdock@thitronik.de", "id": "ffux52ne5pmdg0x", "key": "contact_info_email", "page": "home", "section": "contact_info", "updated": "2026-07-15 14:29:38.180Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.180Z", "en": "ADDRESS", "id": "teqkdn5ddat5wh9", "key": "contact_info_address_label", "page": "home", "section": "contact_info", "updated": "2026-07-15 14:29:38.180Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.180Z", "en": "Finkenweg 9-15, 24340 Eckernförde", "id": "ujjtiuns9ihzukq", "key": "contact_info_address", "page": "home", "section": "contact_info", "updated": "2026-07-15 14:29:38.180Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.180Z", "en": "Belgium, Bulgaria, Denmark, Germany, Estonia, Finland, France, Greece, Ireland, Italy, Croatia, Latvia, Lithuania, Luxembourg, Malta, the Netherlands, Austria, Poland, Portugal, Romania, Sweden, Switzerland, Slovakia, Slovenia, Spain, the Czech Republic, Hungary, Cyprus", "id": "64cz9gu2xzzv5lt", "key": "contact_info_countries", "page": "home", "section": "contact_info", "updated": "2026-07-15 14:29:38.180Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.180Z", "en": "Product - SMARTDOCK", "id": "7cn1sn7uqygqiqz", "key": "product_page_title", "page": "produkte", "section": "header", "updated": "2026-07-15 14:29:38.180Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.180Z", "en": "Discover the SMARTDOCK system. Intelligent modular technology for safe and precise harbor maneuvers.", "id": "oq0is0fn6mwvwii", "key": "product_page_subtitle", "page": "produkte", "section": "header", "updated": "2026-07-15 14:29:38.180Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.180Z", "en": "Home", "id": "hcisdw3p35p3dri", "key": "breadcrumb_home", "page": "produkte", "section": "header", "updated": "2026-07-15 14:29:38.180Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.180Z", "en": "Product", "id": "xvx9zdce36d4pjw", "key": "breadcrumb_product", "page": "produkte", "section": "header", "updated": "2026-07-15 14:29:38.180Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.180Z", "en": "SMARTDOCK", "id": "xy0fodemv14z0gd", "key": "breadcrumb_smartdock", "page": "produkte", "section": "header", "updated": "2026-07-15 14:29:38.180Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.180Z", "en": "Your plug-and-play upgrade for maximum control on board.", "id": "buszgbiy6mxfmid", "key": "intro_tagline", "page": "produkte", "section": "intro", "updated": "2026-07-15 14:29:38.180Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.181Z", "en": "Navigate in Control", "id": "oiyyr51r0e97dlu", "key": "intro_heading", "page": "produkte", "section": "intro", "updated": "2026-07-15 14:29:38.181Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.181Z", "en": "You know your boat—every response, every maneuver. Now you have a system at your side that makes it even easier to maintain that very control—all on your own.", "id": "lr25y0fi52ynggg", "key": "intro_paragraph_1", "page": "produkte", "section": "intro", "updated": "2026-07-15 14:29:38.181Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.181Z", "en": "With SMARTDOCK, you can control your boat directly from your smartphone—whether you're at the bow, the stern, or right in the middle.", "id": "eauxgvfs6ekj41w", "key": "intro_paragraph_2", "page": "produkte", "section": "intro", "updated": "2026-07-15 14:29:38.181Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.181Z", "en": "Docking becomes a smooth, one-man show. No stress, no shouting, no compromises—just you and your boat working in perfect harmony.", "id": "pc2n4onhz2fkc45", "key": "intro_paragraph_3", "page": "produkte", "section": "intro", "updated": "2026-07-15 14:29:38.181Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.181Z", "en": "SMARTDOCK was developed with the goal of offering experienced skippers a whole new level of freedom. It's a system that integrates into existing setups and gives you full control in any situation.", "id": "3bpytvhlobzkpua", "key": "intro_paragraph_4", "page": "produkte", "section": "intro", "updated": "2026-07-15 14:29:38.181Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.181Z", "en": "float magazine put it to the test.", "id": "7dpnylgcyphvonn", "key": "crew_magazine_label", "page": "produkte", "section": "crew", "updated": "2026-07-15 14:29:38.181Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.181Z", "en": "First impression: It's amazingly easy to use—and a lot of fun.", "id": "hla5gge1i9j9wdz", "key": "crew_review_quote", "page": "produkte", "section": "crew", "updated": "2026-07-15 14:29:38.181Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.181Z", "en": "To the review", "id": "4t2s3itlf8gqag0", "key": "crew_review_link", "page": "produkte", "section": "crew", "updated": "2026-07-15 14:29:38.181Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.181Z", "en": "Install. Turn it on. Everything in the app", "id": "wtmrddcxvf10ew9", "key": "app_heading", "page": "produkte", "section": "app", "updated": "2026-07-15 14:29:38.181Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.181Z", "en": "Plug & Play", "id": "wzj6fd0podygo5i", "key": "app_subheading", "page": "produkte", "section": "app", "updated": "2026-07-15 14:29:38.181Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.181Z", "en": "SMARTDOCK is designed according to the plug-and-play principle—once installed, you can conveniently control everything via the app. Installation on board is quick and easy and requires neither complex modifications nor special technical expertise.", "id": "ntoz1endrqwliap", "key": "app_paragraph_1", "page": "produkte", "section": "app", "updated": "2026-07-15 14:29:38.181Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.181Z", "en": "Once it's installed, the app takes over: setup, control, monitoring—everything works intuitively and is managed centrally from your smartphone. You don't need a separate control panel or any additional hardware.", "id": "a1zobirjzmsyvtb", "key": "app_paragraph_2", "page": "produkte", "section": "app", "updated": "2026-07-15 14:29:38.181Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.181Z", "en": "Just connect, start, and enjoy full control—that's what modern boat control looks like.", "id": "1xn6rzordl8xu2l", "key": "app_paragraph_3", "page": "produkte", "section": "app", "updated": "2026-07-15 14:29:38.181Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.181Z", "en": "ENGINE CONTROL UNIT", "id": "qkan519310nkuvj", "key": "modules_ecu_label", "page": "produkte", "section": "modules", "updated": "2026-07-15 14:29:38.181Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.181Z", "en": "SMARTDOCK-ECU", "id": "y1481cyuz6dx7qd", "key": "modules_ecu_title", "page": "produkte", "section": "modules", "updated": "2026-07-15 14:29:38.181Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.181Z", "en": "ECU stands for Engine Control Unit. It is a control unit that allows you to control your boat's engine using the SMARTDOCK app. To do this, the SMARTDOCK ECU uses your boat's digital control systems.", "id": "5e0jpsf12g74t4i", "key": "modules_ecu_description_1", "page": "produkte", "section": "modules", "updated": "2026-07-15 14:29:38.181Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.181Z", "en": "The control information is sent from the smartphone to the ECU, where it is converted into data that the boat's control system can correctly interpret and execute. The boat's helm position is also constantly monitored, so that the helm can take control at any time.", "id": "2c4qse0jypcapax", "key": "modules_ecu_description_2", "page": "produkte", "section": "modules", "updated": "2026-07-15 14:29:38.181Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.181Z", "en": "THRUSTER CONTROL UNIT", "id": "o7r8er5y863iic7", "key": "modules_tcu_label", "page": "produkte", "section": "modules", "updated": "2026-07-15 14:29:38.181Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.181Z", "en": "SMARTDOCK-TCU", "id": "xk9kwgecfz8wetz", "key": "modules_tcu_title", "page": "produkte", "section": "modules", "updated": "2026-07-15 14:29:38.181Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.182Z", "en": "TCU stands for Thruster Control Unit. It is a control unit that allows you to control the bow and stern thrusters using the SMARTDOCK app.", "id": "c2kiruf7j37esv0", "key": "modules_tcu_description_1", "page": "produkte", "section": "modules", "updated": "2026-07-15 14:29:38.182Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.182Z", "en": "The control information from the app is converted into signals for the thrusters, enabling precise control in the desired direction.", "id": "fz86due7gg8z41p", "key": "modules_tcu_description_2", "page": "produkte", "section": "modules", "updated": "2026-07-15 14:29:38.182Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.182Z", "en": "Compatibility", "id": "l7mn0vquqj3kr2g", "key": "compatibility_heading", "page": "produkte", "section": "compatibility", "updated": "2026-07-15 14:29:38.182Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.182Z", "en": "SMARTDOCK integrates seamlessly into existing systems. The system is compatible with Volvo Penta engines manufactured in 2010 or later, MerCruiser/Mercury systems from 2016 onward, and Yamaha engines from 2021 onward (Helm Master EX system). As a result, SMARTDOCK supports a wide range of popular engines and boat types—making it easy to get started with smart boat control.", "id": "uphkg7w8xkc6tnw", "key": "compatibility_description", "page": "produkte", "section": "compatibility", "updated": "2026-07-15 14:29:38.182Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.182Z", "en": "Can't find your drive? No problem—just get in touch with us!", "id": "ogqc0fxrm77lesw", "key": "compatibility_contact_text", "page": "produkte", "section": "compatibility", "updated": "2026-07-15 14:29:38.182Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.182Z", "en": "Get in touch", "id": "0379oaym5drdkt9", "key": "compatibility_contact_link", "page": "produkte", "section": "compatibility", "updated": "2026-07-15 14:29:38.182Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.182Z", "en": "Ready for your next ride?", "id": "xlg33j9rutx8565", "key": "cta_heading", "page": "produkte", "section": "cta", "updated": "2026-07-15 14:29:38.182Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.182Z", "en": "Configure Now", "id": "4anpj7z17gvzg4v", "key": "cta_configure_button", "page": "pro