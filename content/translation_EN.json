ge": "home", "section": "hero", "updated": "2026-07-15 14:29:38.176Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.177Z", "en": "Dealer Locator", "id": "1x9cyrv5gy1aofo", "key": "hero_btn_dealer", "page": "home", "section": "hero", "updated": "2026-07-15 14:29:38.176Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.177Z", "en": "Request Now", "id": "740kz5k1ub9xgp5", "key": "hero_btn_request", "page": "home", "section": "hero", "updated": "2026-07-15 14:29:38.177Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.177Z", "en": "This is SMARTDOCK", "id": "xveszoroac8kwqr", "key": "about_title", "page": "home", "section": "about", "updated": "2026-07-15 14:29:38.177Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.177Z", "en": "The Crew in Your Hand", "id": "2trbnp21ftarxwz", "key": "about_subtitle", "page": "home", "section": "about", "updated": "2026-07-15 14:29:38.177Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.177Z", "en": "SMARTDOCK revolutionizes the way you maneuver your boat. With wireless control of the engines and thrusters, you always have a clear overview and can steer the boat with pinpoint accuracy—even in tight harbors and under difficult wind conditions.", "id": "93vqhugmp2lj7ta", "key": "about_description", "page": "home", "section": "about", "updated": "2026-07-15 14:29:38.177Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.177Z", "en": "For boats of all sizes", "id": "bx8sc6ul21559lb", "key": "about_boats", "page": "home", "section": "about", "updated": "2026-07-15 14:29:38.177Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.177Z", "en": "Loading preview...", "id": "udk4olllbsoerym", "key": "about_loading", "page": "home", "section": "about", "updated": "2026-07-15 14:29:38.177Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.177Z", "en": "Video not available", "id": "s2o78uscbv54ei1", "key": "about_video_unavailable", "page": "home", "section": "about", "updated": "2026-07-15 14:29:38.177Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.177Z", "en": "FIVE REASONS TO CHOOSE SMARTDOCK", "id": "6vxhvtzlofcb91r", "key": "reasons_title", "page": "home", "section": "reasons", "updated": "2026-07-15 14:29:38.177Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.177Z", "en": "More control. Less stress. More freedom.", "id": "3plpu0cc6nj89a3", "key": "reasons_subtitle", "page": "home", "section": "reasons", "updated": "2026-07-15 14:29:38.177Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.177Z", "en": "Discover the benefits that make SMARTDOCK an indispensable solution for modern skippers", "id": "6uvivuwyytzkhob", "key": "reasons_intro", "page": "home", "section": "reasons", "updated": "2026-07-15 14:29:38.177Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.177Z", "en": "Intuitive operation", "id": "jcyfbf6h8mofz0i", "key": "reason_1_title", "page": "home", "section": "reasons", "updated": "2026-07-15 14:29:38.177Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.177Z", "en": "The app has a clear and intuitive layout. A single swipe is all it takes to issue control commands. This makes even challenging maneuvers easier to master—without any complicated additional controls.", "id": "ez17m62bp035qxa", "key": "reason_1_description", "page": "home", "section": "reasons", "updated": "2026-07-15 14:29:38.177Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.177Z", "en": "Precise Control", "id": "g0d6sl05pkxebi0", "key": "reason_2_title", "page": "home", "section": "reasons", "updated": "2026-07-15 14:29:38.177Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.177Z", "en": "Whether it's engines, a bow thruster, or a stern thruster, SMARTDOCK lets you control your boat with precision and without delay. This is especially helpful in tight spaces, in windy conditions, or when there's a current.", "id": "3bqffj68g8qws00", "key": "reason_2_description", "page": "home", "section": "reasons", "updated": "2026-07-15 14:29:38.177Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.177Z", "en": "Wide Reach.", "id": "chr2sdjtjsio7ny", "key": "reason_3_title", "page": "home", "section": "reasons", "updated": "2026-07-15 14:29:38.177Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.177Z", "en": "SMARTDOCK uses Bluetooth LE: a proven and reliable technology. With over 40 channels, the system has a range of 50 meters—ensuring a stable connection, lag-free control commands, and complete freedom of movement on board.", "id": "5iyq379fnagkygi", "key": "reason_3_description", "page": "home", "section": "reasons", "updated": "2026-07-15 14:29:38.177Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.177Z", "en": "Quick to integrate", "id": "8312co8iwx7c6o9", "key": "reason_4_title", "page": "home", "section": "reasons", "updated": "2026-07-15 14:29:38.177Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.177Z", "en": "SMARTDOCK is designed as a plug-and-play solution and can be integrated into compatible propulsion and thruster systems. This reduces the effort required for installation and makes it particularly easy to get started.", "id": "5uxlqvumxmrlh3k", "key": "reason_4_description", "page": "home", "section": "reasons", "updated": "2026-07-15 14:29:38.177Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.177Z", "en": "Designed with the future in mind.", "id": "59dv8z31ftgclyg", "key": "reason_5_title", "page": "home", "section": "reasons", "updated": "2026-07-15 14:29:38.177Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.178Z", "en": "As an app-controlled system, SMARTDOCK is modern, updatable, and modularly expandable. This means you're not only investing in greater convenience for your next harbor maneuver, but also in a solution that can grow with your boat.", "id": "tskj0tebybaovf0", "key": "reason_5_description", "page": "home", "section": "reasons", "updated": "2026-07-15 14:29:38.178Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.178Z", "en": "SMARTDOCK Modules", "id": "oebjrbd5kd3qeai", "key": "modules_title", "page": "home", "section": "modules", "updated": "2026-07-15 14:29:38.178Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.178Z", "en": "Modular design. Perfect for your boat.", "id": "qh2qz7vun73mftf", "key": "modules_subtitle", "page": "home", "section": "modules", "updated": "2026-07-15 14:29:38.178Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.178Z", "en": "Thanks to its modular design, the SMARTDOCK system can be perfectly adapted to the specific needs of your boat.", "id": "aa8ep5xf1tlmuik", "key": "modules_intro", "page": "home", "section": "modules", "updated": "2026-07-15 14:29:38.178Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.178Z", "en": "ECU", "id": "f1ybqbr65cw2emr", "key": "module_ecu_title", "page": "home", "section": "modules", "updated": "2026-07-15 14:29:38.178Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.178Z", "en": "Engine Control Unit for precise control of the main engines.", "id": "zrt9yjt616xnxng", "key": "module_ecu_description", "page": "home", "section": "modules", "updated": "2026-07-15 14:29:38.178Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.178Z", "en": "TCU", "id": "aidxkf7nw5et2pb", "key": "module_tcu_title", "page": "home", "section": "modules", "updated": "2026-07-15 14:29:38.178Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.178Z", "en": "Thruster Control Unit for conventional on/off thrusters.", "id": "ofm088exyuyn32o", "key": "module_tcu_description", "page": "home", "section": "modules", "updated": "2026-07-15 14:29:38.178Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.178Z", "en": "TCU-P", "id": "t8headtprylyybq", "key": "module_tcup_title", "page": "home", "section": "modules", "updated": "2026-07-15 14:29:38.178Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.178Z", "en": "Proportional Thruster Control Unit for speed-controlled thrusters.", "id": "jwqvgzoofdp7gxj", "key": "module_tcup_description", "page": "home", "section": "modules", "updated": "2026-07-15 14:29:38.178Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.178Z", "en": "ACU", "id": "3ehdsv4nnpm71yf", "key": "module_acu_title", "page": "home", "section": "modules", "updated": "2026-07-15 14:29:38.178Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.178Z", "en": "Anchor Control Unit for operating anchor winches, a thruster, and a horn.", "id": "twfo5tkokr9ksoc", "key": "module_acu_description", "page": "home", "section": "modules", "updated": "2026-07-15 14:29:38.178Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.178Z", "en": "WCU", "id": "h84adcpp4y8otpd", "key": "module_wcu_title", "page": "home", "section": "modules", "updated": "2026-07-15 14:29:38.178Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.178Z", "en": "Winch Control Unit for controlling winches and horns.", "id": "eg2kixarsriop7e", "key": "module_wcu_description", "page": "home", "section": "modules", "updated": "2026-07-15 14:29:38.178Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.178Z", "en": "Coming soon", "id": "1a8yxdoof0sazfn", "key": "module_coming_soon", "page": "home", "section": "modules", "updated": "2026-07-15 14:29:38.178Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.178Z", "en": "Find an installation partner near you", "id": "pz8iz0a90w0zwv8", "key": "dealer_title", "page": "home", "section": "dealer", "updated": "2026-07-15 14:29:38.178Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.178Z", "en": "Our certified SMARTDOCK partners will handle the professional installation and maintenance of your system.", "id": "qsa5qxqr65hly2x", "key": "dealer_description", "page": "home", "section": "dealer", "updated": "2026-07-15 14:29:38.178Z"}, {"collectionId": "pbc_7391812377", "collectionName": "translation_EN", "created": "2026-07-15 14:29:38.178Z", "en": "Open the Dealer Locator.", "id": "t0tjaoxhxs9cxo3", "key": "dealer_btn", "page": "home", "section": "dealer", "updated": "2026-07-15 14:29:38.178Z"}, {"collectionId": "pbc_7391812377", "collectionName": 